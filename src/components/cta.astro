---
import { DISABLED_LABEL_CLASS, getCtaState } from "../utils/cta-contract";

interface Props {
  as?: "a" | "button";
  href?: string;
  external?: boolean;
  label: string;
  disabled?: boolean;
  disabledLabel?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  as = "a",
  href,
  external = false,
  label,
  disabled = false,
  disabledLabel = "PRONTO",
  class: extraClass,
  ...attrs
} = Astro.props as Props;

const isLink = as === "a";
const state = getCtaState(disabled);
const classes = [state.class, extraClass].filter(Boolean).join(" ");

// A disabled link drops its href so it is neither navigable nor focusable;
// a disabled button uses the native attribute. Both carry the label as a
// tooltip for pointer users and an inline badge for everyone else.
const tagSpecificAttrs = disabled
  ? isLink
    ? { "aria-disabled": state.ariaDisabled, title: disabledLabel }
    : { type: "button", disabled: true, title: disabledLabel }
  : isLink
    ? {
        href,
        target: external ? "_blank" : undefined,
        rel: external ? "noopener noreferrer" : undefined,
      }
    : { type: "button" };
const Element = as;
---

<Element
  class={classes}
  data-cta="true"
  data-cta-as={as}
  data-cta-state={disabled ? "disabled" : "enabled"}
  {...tagSpecificAttrs}
  {...attrs}
>
  {label}
  {state.showsDisabledLabel && (
    <span class={DISABLED_LABEL_CLASS}>{disabledLabel}</span>
  )}
  {!disabled && isLink && external && (
    <span aria-hidden="true" class="ml-1">
      ↗
    </span>
  )}
</Element>
